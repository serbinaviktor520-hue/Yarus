        "Location": "/$1/"
      },
      "has": [
        {
          "type": "host",
          "value": "tyshahello.win"
        }
      ]
    },
    {
      "src": "^/(?!tysha/)(.*)$",
      "has": [
        {
          "type": "host",
          "value": "tyshahello.win"
        }
      ],
      "dest": "/tysha/$1",
      "continue": true

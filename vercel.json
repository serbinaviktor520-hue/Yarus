{
  "routes": [
    {
      "src": "^/assets/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/tysha/assets/fonts/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/tysha/img/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400"
      },
      "continue": true
    },
    {
      "src": "^/(.*/)?index\\.html$",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "^/tysha/projects/?$",
      "status": 301,
      "headers": {
        "Location": "/tysha/project/"
      }
    },
    {
      "src": "^/tysha/project/lull/?$",
      "status": 301,
      "headers": {
        "Location": "/tysha/project/lull-house/"
      }
    },
    {
      "src": "^/tysha/project/pinecourt/?$",
      "status": 301,
      "headers": {
        "Location": "/tysha/project/pine-court/"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/((?:[^/]+/)*[^/.]+)$",
      "status": 308,
      "headers": {
        "Location": "/$1/"
      }
    },
    {
      "src": "^/tysha/.*$",
      "status": 404,
      "dest": "/tysha/404/index.html"
    }
  ]
}

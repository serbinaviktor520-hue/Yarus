{
  "routes": [
    {
      "src": "^/(.*)$",
      "status": 308,
      "headers": {
        "Location": "https://tyshahello.win/$1"
      },
      "has": [
        {
          "type": "host",
          "value": "www.tyshahello.win"
        }
      ]
    },
    {
      "src": "^/tysha(?:/((?:[^/]+/)*[^/.]*))?$",
      "status": 308,
      "headers": {
        "Location": "/$1"
      },
      "has": [
        {
          "type": "host",
          "value": "tyshahello.win"
        }
      ]
    },
    {
      "src": "^/(.*/)?index\\.html$",
      "status": 308,
      "headers": {
        "Location": "/$1"
      },
      "has": [
        {
          "type": "host",
          "value": "tyshahello.win"
        }
      ]
    },
    {
      "src": "^/projects/?$",
      "status": 301,
      "headers": {
        "Location": "/project/"
      },
